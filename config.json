{
    "_schema_version": "2.0",
    "_description": "Multi-Horizon Multi-Agent UAV Active Sensing Configuration",

    "simulation": {
        "_comment": "Core simulation settings",
        "field_type": "Gaussian",
        "start_position": "corner",
        "num_steps": 50,
        "iterations": [0, 1],
        "correlation_types": ["equal"],
        "error_margins": [null],
        "project_path": "./"
    },

    "strategy": {
        "_comment": "Action strategy selection: greedy_ig, dec_mcts, mh_dec_mcts (or hierarchical_dec_mcts)",
        "type": "greedy_ig"
    },

    "agents": {
        "_comment": "Multi-agent configuration",
        "num_agents": 2,
        "start_positions": "corner",
        "communication_range": -1,
        "collision_avoidance_distance": 5.0     
    },

    "planner": {
        "_comment": "MCTS planner parameters",
        "planning_depth": 15,
        "num_iterations": 100,
        "ucb1_exploration": 0.95,
        "discount_factor": 0.99,
        "timeout_ms": 2000,
        "parallel_simulations": 1
    },

    "greedy_ig": {
        "_comment": "Greedy IG baseline planner settings (single-step lookahead)",
        "intent_discount": 0.5,
        "overlap_penalty_weight": 0.3
    },

    "dec_mcts": {
        "_comment": "Dec-MCTS planner settings (single-level MCTS, multi-agent)",
        "horizon": 10,
        "iterations": 100,
        "ucb_c": 1.4,
        "discount_factor": 0.95,
        "overlap_penalty_weight": 0.3,
        "timeout": 5.0,
        "parallel": 1
    },

    "hierarchical_dec_mcts": {
        "_comment": "Multi-Horizon Dec-MCTS (alias: mh_dec_mcts) - LLP + HLP hierarchy",
        "llp_horizon": 5,
        "llp_iterations": 50,
        "hlp_horizon": 3,
        "hlp_iterations": 30,
        "tile_size": [100, 100],
        "hlp_replan_interval": 1.0
    },

    "belief": {
        "_comment": "Belief fusion and LBP settings",
        "fusion_enabled": true,
        "fusion_method": "lbp",
        "lbp": {
            "enabled": true,
            "iterations": 1,
            "pairwise_potential_type": "equal",
            "_pairwise_options": "equal (0.5/0.5), biased (0.7/0.3), adaptive (computed from observations)"
        },
        "news_mode": "BM"
    },

    "decentralized": {
        "_comment": "Fully decentralized agent communication settings",
        "enabled": true,
        "sharing": {
            "belief_fusion": true,
            "llp_intent": true,
            "hlp_intent": true,
            "position": true
        },
        "communication": {
            "message_queue_size": 100,
            "stale_threshold_sec": 10.0,
            "drop_probability": 0.0,
            "message_delay_sec": 0.0
        },
        "coordination": {
            "intent_horizon": 5,
            "intent_discount": 0.8,
            "overlap_penalty_weight": 0.3,
            "d_uct": {
                "_comment": "D-UCT discounting for asynchronous drift handling",
                "enabled": true,
                "decay_factor": 0.9,
                "min_visits_before_decay": 5,
                "stale_intent_threshold_sec": 2.0
            }
        },
        "async": {
            "_comment": "True asynchronous execution settings",
            "enabled": false,
            "planning_rate_hz": 5.0,
            "hlp_rate_hz": 2.0,
            "observation_rate_hz": 10.0,
            "comm_delay_ms": 50.0,
            "drop_probability": 0.0,
            "max_intent_age_sec": 5.0,
            "sync_every_n_steps": 10
        }
    },

    "output": {
        "_comment": "Logging and visualization settings",
        "enable_plotting": true,
        "enable_logging": true,
        "save_steps": true
    }
}