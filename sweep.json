{
  "_comment": "Hyperparameter Sweep — MH-Eff and MH-Full ablations",
  "_description": "8 experiments covering 4 clean ablation axes: (1) g2 on/off, (2) HLP horizon length, (3) region tile granularity, (4) LLP depth/exploration. All: 4 agents, 100 steps, IG_BS, Gaussian field, corner start.",
  "base_config": "configs/master_config.json",
  "experiments": [
    {
      "_comment": "--- MH-EFF (random LLP, cheap) ---",
      "name": "mh_eff_no_g2",
      "_axis": "g2 ablation — no coordination signal",
      "overrides": {
        "strategies": ["mh_dec_mcts_efficient"],
        "strategy_configs": {
          "mh_dec_mcts_efficient": "../../configs/strategies/sweeps/mh_eff_fast_replan_hlp5_rep1.json"
        },
        "shared": {
          "mode_labels": ["IG_BS"],
          "cluster_radius": 5,
          "num_agents": 4,
          "n_steps": 100,
          "iters": [0, 20],
          "field_type": "Gaussian",
          "start_position": "corner",
          "correlation_types": ["adaptive"],
          "enable_plotting": false,
          "enable_logging": true,
          "debug_logs": false
        }
      }
    },
