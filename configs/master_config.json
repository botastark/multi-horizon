{
  "_comment": "Master Experiment Configuration - Two Swarm Options Comparison",
  "_description": "When limited_testing=true: only IG_BS (inf comm) and IGd_BM (limited comm)",
  "limited_testing": true,
  
  "strategies": [

    "mh_dec_mcts_full"
  ],
  "_comment_strategies": "Define the strategy configurations and their corresponding config file paths (greedy_ig, dec_mcts, mh_dec_mcts_full, mh_dec_mcts_efficient)",
  
  "strategy_configs": {
    "greedy_ig": "strategies/greedy_ig.json",
    "dec_mcts": "strategies/dec_mcts.json",
    "mh_dec_mcts_full": "strategies/mh_dec_mcts_full.json",
    "mh_dec_mcts_efficient": "strategies/mh_dec_mcts_efficient.json"
  },
  
  "shared": {
    "project_path": "./",
    "field_type": "Gaussian",
    "cluster_radius": 4,
    "start_position": "corner",
    "num_agents": 4,
    "n_steps": 100,
    "iters": [0, 1],
    "correlation_types": ["adaptive"],
    "error_margins": [null],
    "enable_plotting": true,
    "enable_logging": true,
    "mode_labels": ["IG_BS", "IGd_BM"]
  },
  
  "decentralized": {
    "_comment": "Shared multi-agent communication settings",
    "communication_range": 15.625,
    "communication_delay": 0.05,
    "message_drop_probability": 0.0,
    "d_uct": {
      "decay_factor": 0.9,
      "threshold_sec": 2.0
    }
  },
  
  "experiment": {
    "_comment": "Experiment logging and output settings",
    "base_log_dir": "trials",
    "save_trajectory": false,
    "save_belief_maps": false,
    "common_metrics": [
      "cumulative_ig",
      "coverage_ratio",
      "messages_sent",
      "compute_time_ms"
    ]
  }
}
