    "llp_horizon": 3,
    "llp_iterations": 50,
    "llp_ucb_c": 1.4,
    "llp_discount_factor": 0.95,
    "hlp_horizon": 10,
    "hlp_iterations": 30,
    "hlp_ucb_c": 1.0,
