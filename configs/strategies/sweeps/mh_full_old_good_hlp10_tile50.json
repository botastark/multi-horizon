{
  "_comment": "MH-Full - old good benchmark params: LLP h3/i50, HLP h10/i30, tile 50, replan 1",
  "_description": "Translated from older mh_dec_mcts benchmark config to canonical mh_dec_mcts_full strategy.",
  "action_strategy": "mh_dec_mcts_full",
  "n_steps": 100,
