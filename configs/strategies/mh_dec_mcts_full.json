{
  "_comment": "Strategy 3: MH-Dec-MCTS (full) - Hierarchical with both HLP and LLP using MCTS",
  "_description": "Full hierarchical baseline: Both planners use UCB tree search",
  
  "action_strategy": "mh_dec_mcts_both",
  
  "hierarchical_dec_mcts": {
    "use_mcts_llp": true,
    "use_g2": true,
    
    "llp": {
      "_comment": "Low-Level Planner - tactical action selection with MCTS tree search",
      "horizon": 3,
      "iterations": 30,
      "ucb_c": 1.4,
      "discount_factor": 0.95
    },
    
    "hlp": {
      "_comment": "High-Level Planner - strategic region allocation with MCTS tree search",
      "horizon": 8,
      "iterations": 20,
      "ucb_c": 1.0,
      "discount_factor": 0.98,
      "tile_size": [50, 50],
      "replan_interval": 2.0
    },
    
    "intent_sharing": {
      "ll_broadcast_interval": 0.1,
      "hl_broadcast_interval": 0.5,
      "max_history": 10
    }
  },
  
  "decentralized": {
    "overlap_penalty_weight": 0.3
  },
  
  "experiment": {
    "name": "mh_dec_mcts_full_benchmark",
    "log_dir_suffix": "mh_dec_mcts_full",
    "strategy_metrics": [
      "llp_iterations",
      "llp_planning_time_ms",
      "hlp_iterations",
      "hlp_planning_time_ms",
      "ll_intents_sent",
      "hl_intents_sent"
    ]
  }
}
