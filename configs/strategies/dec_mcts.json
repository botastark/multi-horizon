{
  "_comment": "Dec-MCTS - Reactive: Short horizon, more iterations",
  "action_strategy": "dec_mcts",

  "dec_mcts": {
    "horizon": 5,
    "iterations": 50,
    "ucb_c": 1.4,
    "discount_factor": 0.95,
    "timeout": 5.0,
    "parallel": 1,
    "_use_g2": "Baseline = flat Dec-MCTS with the same g2 coverage term as MH-Dec-MCTS (no HLP); g2_weight null = auto",
    "use_g2": true,
    "g2_weight": null
  },

  "decentralized": {
    "overlap_penalty_weight": 0.3,
    "radius_multiplier": 5
  },

  "experiment": {
    "name": "dec_mcts_reactive_h5_i50_notsweeprun",
    "log_dir_suffix": "dec_mcts",
    "strategy_metrics": ["mcts_iterations", "planning_time_ms"]
  }
}
