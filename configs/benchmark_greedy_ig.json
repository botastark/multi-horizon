{
  "_comment": "Greedy IG Benchmark Configuration",
  "_description": "Single-step lookahead IG maximization baseline (paper approach)",
  
  "project_path": "./",
  "field_type": "Gaussian",
  "start_position": "corner",
  "action_strategy": "greedy_ig",
  "num_agents":4,
  "n_steps": 50,
  "iters": [0,20],
  "correlation_types": ["adaptive"],
  "error_margins": [null],
  "enable_plotting": false,
  "enable_logging": true,
  
  "greedy_ig": {
    "_comment": "Pure belief-based IG, no penalties: IG=no sharing, IGd=discounted IoU, BS=broadcast single news, BM=per-neighbor news",
    "overlap_penalty_weight": 0.0,
    "mode_labels": ["IG", "IG_BS", "IG_BM", "IGd", "IGd_BS", "IGd_BM"]
  },
  
  "decentralized": {
    "_comment_modes": "Communication settings for greedy IG benchmark",
    "communication_range": -1
  }, 
  
  "experiment": {
    "name": "greedy_ig_benchmark",
    "log_dir": "logs/greedy_ig",
    "save_trajectory": true,
    "save_belief_maps": false,
    "metrics": [
      "cumulative_ig",
      "coverage_ratio",
      "fragmentation_score",
      "messages_sent",
      "compute_time_ms"
    ]
  }
}
