{
  "_comment": "Greedy IG Benchmark Configuration",
  "_description": "Single-step lookahead IG maximization baseline (paper approach)",
  
  "project_path": "./",
  "field_type": "Gaussian",
  "start_position": "corner",
  "action_strategy": "greedy_ig",
  "num_agents":4,
  "n_steps": 100,
  "iters": [0,20],
  "correlation_types": ["equal"],
  "error_margins": [null],
  "enable_plotting": false,
  "enable_logging": true,
  
  "greedy_ig": {
    "_comment": "Paper approach: pure belief-based IG, no penalties",
    "overlap_penalty_weight": 0.0
  },
  
  "decentralized": {
    "_comment_modes": "IG=no sharing, IG_d=position only, BS=broadcast single news, BM=per-neighbor news",
    "communication_range": -1,
    "position_sharing": false,
    "news_sharing": true,
    "news_mode": "BM"
  }, 
  
  "experiment": {
    "name": "greedy_ig_benchmark",
    "log_dir": "logs/greedy_ig",
    "save_trajectory": true,
    "save_belief_maps": false,
    "metrics": [
      "cumulative_ig",
      "coverage_ratio",
      "fragmentation_score",
      "messages_sent",
      "compute_time_ms"
    ]
  }
}
