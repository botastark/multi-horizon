{
  "_comment": "Greedy IG Benchmark Configuration",
  "_description": "Single-step lookahead IG maximization baseline",
  
  "project_path": "./",
  "field_type": "Gaussian",
  "start_position": "corner",
  "action_strategy": "greedy_ig",
  "num_agents": 4,
  "max_steps": 100,
  "n_steps": 100,
  "iters": [0, 1],
  "iterations": [0, 1],
  "correlation_types": ["equal", "biased", "adaptive"],
  "error_margins": [null],
  "enable_plotting": false,
  "enable_logging": true,
  
  "greedy_ig": {
    "intent_discount": 0.5,
    "overlap_penalty_weight": 0.3
  },
  
  "decentralized": {
    "communication_range": 150.0,
    "communication_delay": 0.05,
    "message_drop_probability": 0.0,
    "overlap_penalty_weight": 0.3,
    "d_uct": {
      "decay_factor": 0.9,
      "threshold_sec": 2.0
    }
  },
  
  "experiment": {
    "name": "greedy_ig_4agents",
    "log_dir": "logs/greedy_ig",
    "save_trajectory": true,
    "save_belief_maps": false,
    "metrics": [
      "cumulative_ig",
      "coverage_ratio",
      "fragmentation_score",
      "messages_sent",
      "compute_time_ms"
    ]
  }
}
