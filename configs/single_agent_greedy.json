  "greedy_ig": {
    "intent_discount": 0.0,
    "overlap_penalty_weight": 0.0
  },
  "seed": 1234,
  "experiment": {
    "name": "greedy_ig",
    "log_dir": "logs/greedy_ig_single",
    "save_trajectory": true,
    "metrics": [
      "cumulative_ig",
      "coverage_ratio",
      "compute_time_ms"
    ]
  }
}
