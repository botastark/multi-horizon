{
  "_comment": "Single-Agent Greedy IG Configuration",
  "_description": "Greedy IG baseline in single-agent mode",
  
  "project_path": "./",
  "field_type": "Gaussian",
  "start_position": "corner",
  "action_strategy": "greedy_ig",
  "num_agents": 1,
  "n_steps": 100,
  "iters": [0, 5],
  "correlation_types": ["equal", "biased", "adaptive"],
  "error_margins": [null],
  "enable_plotting": false,
