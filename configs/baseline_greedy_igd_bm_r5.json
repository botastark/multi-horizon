{
  "_comment": "Baseline Config 2: Greedy IGd with IGd_BM mode and limited communication R=5",
  "_description": "For validation before refactoring - R=5 + IGd_BM",

  "action_strategy": "greedy_ig",
  "enable_plotting": false,
  "enable_logging": true,

  "shared": {
    "project_path": "./",
    "field_type": "Gaussian",
    "cluster_radius": 4,
    "start_position": "corner",
    "num_agents": 4,
    "n_steps": 100,
    "iters": [0, 20],
    "correlation_types": ["adaptive"],
    "error_margins": [null],
    "mode_labels": ["IGd_BM"],
    "debug_logs": false
  },

  "greedy_ig": {
    "overlap_penalty_weight": 0.0,
    "enable_discounting": true
  },

  "decentralized": {
    "_comment": "R=5: radius_multiplier=5, comm_range = 5 × 3.125 = 15.625m",
    "radius_multiplier": 5
  },

  "multi_agent": {
    "num_agents": 4,
    "news_mode": "BM",
    "news_inference_type": "LBP",
    "fusion_eps": 0.0,
    "shared_observation_rng": true,
    "metric_aggregation": "fused_mean",
    "clip_metric_beliefs": false
  },

  "experiment": {
    "name": "baseline_greedy_igd_bm_r5",
    "base_log_dir": "experiments/baseline",
    "save_trajectory": true,
    "save_belief_maps": false
  }
}
